// Environment variables example
// Copy this to .env and fill in your values

EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google OAuth Client IDs (get from Google Cloud Console)
# For development with Expo proxy:
# 1. Use the same Web Client ID for EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
# 2. Add this redirect URI to your Google OAuth app:
#    https://auth.expo.io/@your-expo-username/movies-mobile
# 3. Get platform-specific IDs for production builds
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com
